{$DOMINIO} {
	encode zstd gzip

	# Escenas satelitales completas. Las Skysat rondan 1,8 GB; para esas
	# conviene mas dejarlas por scp en /datos/entrada e importarlas desde
	# el visor, pero el limite se deja holgado por si se sube una directa.
	request_body {
		max_size 2500MB
	}

	# API y chequeo de salud -> FastAPI
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}

	# Visor estatico. Sin build step: los archivos de ./web se sirven tal cual.
	handle {
		root * /srv/web
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /data/acceso.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}

{$DOMINIO} {
	encode zstd gzip

	# Los archivos grandes ya no llegan de una pieza sino en trozos de como
	# mucho 32 MB, asi que el limite puede ser pequeno. Que lo sea es bueno:
	# ninguna peticion suelta puede ocupar la API durante minutos.
	request_body {
		max_size 64MB
	}

	# Una subida por trozos de 1,8 GB puede durar bastante; que Caddy no corte
	# la conversacion a mitad.
	timeouts {
		read_body 10m
	}

	# API y chequeo de salud -> FastAPI
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}

	# Visor estatico. Sin build step: los archivos de ./web se sirven tal cual.
	handle {
		root * /srv/web
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /data/acceso.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}

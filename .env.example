# Copiar a .env y rellenar. NUNCA subir .env al repo.
#
# Generar secretos con:
#   openssl rand -base64 24

# Clave compartida que usa todo el equipo para entrar al visor.
CLAVE_ACCESO=cambiar-esta-clave

# Firma de las cookies de sesion. Si se cambia, todos deben volver a entrar.
SECRET_KEY=cambiar-este-secreto-largo-y-aleatorio

# Base de datos (el contenedor la crea en el primer arranque).
POSTGRES_USER=geovisor
POSTGRES_PASSWORD=cambiar-esta-password
POSTGRES_DB=geovisor

# Dominio publico. Sin dominio propio, sslip.io resuelve la IP automaticamente
# y permite obtener certificado Let's Encrypt real (necesario para el GPS).
DOMINIO=5.161.176.32.sslip.io

# Duracion de la sesion en horas.
SESION_HORAS=72
